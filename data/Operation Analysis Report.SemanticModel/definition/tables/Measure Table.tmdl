table 'Measure Table'
	lineageTag: 4fda4096-cb75-4d9d-a105-10347004ba2b

	measure Revenue = SUM(fact_store_monthly_profitability[total_monthly_revenue_gbp])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: d95b56c7-4a04-40f2-8ff9-0f741e1509b5

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Net Profit' = ```
			SUM(fact_store_monthly_profitability[net_profit_gbp])
			
			```
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: db497854-d29e-45e6-ab92-316fb9d3f70f

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Net Margin %' = ```
			DIVIDE([Net Profit], [Revenue])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: eb23966a-689c-45f4-9f59-80fe7fbbe686

	measure 'Gross Profit' = SUM(fact_daily_sales[daily_gross_profit_gbp])
		formatString: #,0.00
		lineageTag: 93602d88-2d13-4fa3-89ef-ea4c565fd262

	measure 'Revenue PM' = CALCULATE([Revenue], DATEADD(dim_date[full_date], -1, MONTH))
		lineageTag: c4c0a436-b220-4b6a-980d-0ef4553a8a90

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue MoM %' = DIVIDE([Revenue] - [Revenue PM], [Revenue PM])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9b73767c-b415-4158-ae14-70d4c37fa146

	measure 'Network Margin %' = CALCULATE([Net Margin %], ALL(dim_store))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c4644c82-3aa6-4199-a332-57b350bb56be

	measure 'Margin Gap (pts)' = [Net Margin %] - [Network Margin %]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3f0bcc81-4547-4120-b836-adecc5f62449

	measure 'Loss-Making Stores' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), [Net Profit] < 0))
		formatString: 0
		lineageTag: 3bd2031b-d020-44d0-bd41-9e50ffd28a36

	measure 'Loss Store Revenue Share' =
			
			DIVIDE(CALCULATE([Revenue], FILTER(VALUES(dim_store[store_id]), [Net Profit] < 0)), [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9d166136-0394-4764-bfd2-9303ae2ab650

	measure 'Staffing % Rev' = DIVIDE(SUM(fact_store_monthly_profitability[monthly_staffing_cost_gbp]), [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bc1f708c-54a2-4d72-84ba-28beea7d154b

	measure 'Rent % Rev' = DIVIDE(SUM(fact_store_monthly_profitability[monthly_rent_gbp]), [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 59db8c89-f368-4229-9cd3-4f9045f8c462

	measure 'Loyalty Cost % Rev' = DIVIDE(SUM(fact_store_monthly_profitability[loyalty_redemption_cost_gbp]), [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 429ff989-f673-4f59-8f2e-123aca895500

	measure COGS = SUM(fact_store_monthly_profitability[total_monthly_cogs_gbp])
		formatString: #,0.00
		lineageTag: e0ce7dec-5242-4242-8427-d38090dcbc9b

	measure 'Avg Footfall' = AVERAGE(fact_store_monthly_profitability[avg_daily_footfall])
		formatString: #,0.00
		lineageTag: 053d223b-3b8a-4b53-b6ea-cb832e16fd1a

	measure 'P1 Insight' =
			
			VAR worst = TOPN(1, VALUES(dim_store[store_name]), [Net Margin %], ASC)
			VAR worstName = MAXX(worst, dim_store[store_name])
			RETURN
			[Loss-Making Stores] & " stores are loss-making and generate " &
			FORMAT([Loss Store Revenue Share], "0.0%") & " of revenue. Lowest margin: " &
			worstName & " at " & FORMAT(CALCULATE([Net Margin %], dim_store[store_name] = worstName), "0.0%") &
			". Network margin is " & FORMAT([Network Margin %], "0.0%") &
			". Action: review rent and staffing in loss-making stores before investing in volume."
		lineageTag: 0af8be98-8c68-481d-98fe-707b6609ffa6

	measure 'Waterfall Value' =
			
			VAR rev   = [Revenue]
			VAR cogs  = SUM(fact_store_monthly_profitability[total_monthly_cogs_gbp])
			VAR rent  = SUM(fact_store_monthly_profitability[monthly_rent_gbp])
			VAR staff = SUM(fact_store_monthly_profitability[monthly_staffing_cost_gbp])
			VAR loy   = SUM(fact_store_monthly_profitability[loyalty_redemption_cost_gbp])
			VAR other = [Net Profit] - (rev - cogs - rent - staff - loy)
			RETURN
			SWITCH(
			    SELECTEDVALUE('Waterfall Lines'[Line]),
			    "Revenue", rev,
			    "COGS", -cogs,
			    "Rent", -rent,
			    "Staffing", -staff,
			    "Loyalty", -loy,
			    "Other / Unallocated", IF(ABS(other) < 1, BLANK(), other)
			)
		lineageTag: f26ff776-40ca-42d3-bbfc-34a3bb010f82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Staff Hour' = DIVIDE(SUM(fact_daily_sales[total_revenue_gbp]), SUM(fact_daily_sales[total_staff_hours]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 0930b823-9dfd-4932-8b8e-2b36147f626d

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Transaction per Staff Hour' = DIVIDE(SUM(fact_daily_sales[total_transactions]), SUM(fact_daily_sales[total_staff_hours]))
		lineageTag: a3b0066d-6ae0-4ae6-904f-d3ea59fce701

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak-to-Dead Ratio' =
			DIVIDE(SUM(fact_store_monthly_profitability[peak_hour_transactions]),
			                            SUM(fact_store_monthly_profitability[dead_hour_transactions]))
		lineageTag: 0e6cb438-faa9-4599-abb8-ef74072899d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Dwell Time' = AVERAGE(fact_daily_sales[avg_dwell_time_minutes])
		lineageTag: 4150354f-170b-4db7-af66-29b4e000c0cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Footfall' = DIVIDE(SUM(fact_daily_sales[total_revenue_gbp]), SUM(fact_daily_sales[footfall]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: dcbd0161-0f6b-4c22-bd3e-f96b32a22aa3

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'P2 Insight' =
			
			"Revenue per staff hour is " & FORMAT([Revenue per Staff Hour], "£0.00") &
			" with staffing at " & FORMAT([Staffing % Rev], "0.0%") & " of revenue. " &
			"Peak-to-dead ratio is " & FORMAT([Peak-to-Dead Ratio], "0.0") & "x. " &
			IF([Peak-to-Dead Ratio] > 3, "Demand is highly concentrated: shift labour toward peak windows.",
			   "Demand is evenly spread: review whether dead-hour staffing can be reduced.")
		lineageTag: ea0251f5-a829-4588-9ea1-67353c2f10a9

	measure 'Loyalty Revenue %' =
			DIVIDE(SUM(fact_store_monthly_profitability[loyalty_member_spend_gbp]),
			    SUM(fact_store_monthly_profitability[loyalty_member_spend_gbp]) +
			    SUM(fact_store_monthly_profitability[non_member_spend_gbp]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 10a106b0-5324-444e-984b-2433ffa17ec3

	measure 'Gross Margin %' = DIVIDE([Revenue] - [COGS], [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6962c85c-1446-472d-ad8a-41647f552aa4

	measure 'Store Risk Score' =
			
			VAR a = IF([Net Margin %] < [Network Margin %], 1, 0)
			VAR b = IF([Staffing % Rev] > CALCULATE([Staffing % Rev], ALL(dim_store)), 1, 0)
			VAR c = IF([Rent % Rev] > CALCULATE([Rent % Rev], ALL(dim_store)), 1, 0)
			RETURN a + b + c
		formatString: 0
		lineageTag: d85103e8-8e03-45b9-b0e9-66b93307ba5e

	measure 'Priority Action' =
			
			SWITCH([Store Risk Score], 3, "Restructure", 2, "Monitor", "Maintain")
		lineageTag: da255e1d-043d-425e-a68e-c325857d8ad0

	measure 'Stores Needing Action' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), [Store Risk Score] >= 3))
		formatString: 0
		lineageTag: f79fe25d-75c9-4527-9313-bb8919ee9023

	measure 'P3 Insight' =
			
			VAR r = [Loyalty-Margin r]
			VAR rTxt = IF(ABS(r) < 0.3, "no meaningful link", IF(r > 0, "a positive link", "a negative link"))
			RETURN
			[Stores Needing Action] & " stores exceed the network on staffing cost, rent and margin gap at once. " &
			"Staffing takes " & FORMAT([Staffing % Rev], "0.0%") & " of revenue and rent " & FORMAT([Rent % Rev], "0.0%") & ". " &
			"Loyalty share of spend shows " & rTxt & " with margin (r = " & FORMAT(r, "0.00") & "). " &
			"Action: work through the 'Restructure' stores in the table, starting with the cost marked as their primary driver."
		lineageTag: 8b7ef86d-0d45-427d-a9ad-b19a8baa0c2d

	measure 'Rev & Profit label' = FORMAT([Revenue]/1000000, "£#0.00M") & "  | " & FORMAT([Net Margin %], "0.00%")
		lineageTag: 333a5f4f-6c52-454b-96ca-9e1148f99985

	measure 'Fixed Cost % Rev' = [Rent % Rev] + [Staffing % Rev]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 01423598-82b6-4f12-b876-69a415793877

	measure 'Ref Revenue' =
			
			VAR py = CALCULATE([Revenue], SAMEPERIODLASTYEAR(dim_date[full_date]))
			VAR g = DIVIDE([Revenue] - py, py)
			RETURN IF(ISBLANK(py), "No prior-year data to compare",
			    IF(g >= 0, "▲ ", "▼ ") & FORMAT(ABS(g), "0.0%") & " vs same period LY")
		lineageTag: f67d9754-53b1-4da9-8841-03ae17ed95fa

	measure 'Ref Net Profit' =
			
			VAR py = CALCULATE([Net Profit], SAMEPERIODLASTYEAR(dim_date[full_date]))
			VAR d = [Net Profit] - py
			VAR dTxt = IF(ABS(d) >= 1000000, FORMAT(ABS(d)/1000000, "£0.0") & "M", FORMAT(ABS(d)/1000, "£#,0") & "K")
			RETURN IF(ISBLANK(py), "No prior-year data to compare",
			    IF(d >= 0, "▲ ", "▼ ") & dTxt & " vs same period LY")
		lineageTag: d0964d4b-8f26-4aae-87f6-d9eda7d212a8

	measure 'Ref Net Margin' =
			
			VAR gap = [Margin Gap (pts)]
			RETURN FORMAT(ABS(gap), "0.00%") & " " & IF(gap >= 0, "above", "below") &
			    " network margin of " & FORMAT([Network Margin %], "0.00%")
		lineageTag: e56c1099-98c1-40d6-bc86-2ea9e573a2bd

	measure 'Ref Loss Share' =
			
			VAR n = [Loss-Making Stores]
			VAR t = [Active Stores]
			RETURN
			IF(n = 0, "No loss-making stores in this selection",
			    n & IF(n = 1, " store is", " stores are") & " loss-making, out of " & t &
			    " (" & FORMAT(DIVIDE(n, t), "0%") & " of stores)")
		lineageTag: f174d805-bead-438a-a073-5afb4009c59c

	measure 'Active Stores' = DISTINCTCOUNT(fact_store_monthly_profitability[store_id])
		formatString: 0
		lineageTag: 2f866cc9-823d-4f38-86ba-26c318bfe069

	measure 'Ref Fixed Cost' =
			
			VAR net = CALCULATE([Fixed Cost % Rev], ALL(dim_store))
			VAR gap = [Fixed Cost % Rev] - net
			RETURN FORMAT(ABS(gap), "0.00%") & IF(gap > 0, " above", " below") &
			    " network (" & FORMAT(net, "0.00%") & ") - rent + staffing"
		lineageTag: 950b8915-adbd-4551-8ac9-23eec98b5ac3

	measure 'Ref Loss Revenue Share' =
			
			FORMAT([Loss Store Revenue Share], "0.00%") & " of revenue comes from loss-making stores"
		lineageTag: 7a1e1db0-7616-4770-9f50-b7ea0de3a110

	measure 'Margin Recovery Potential' =
			
			VAR netM = [Network Margin %]
			RETURN
			SUMX(
			    VALUES(dim_store[store_id]),
			    VAR r = [Revenue]
			    VAR m = [Net Margin %]
			    RETURN IF(NOT ISBLANK(m) && m < netM, (netM - m) * r, 0)
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: c4892419-35a4-4773-b3db-b8d7e5cffa48

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Below-Par Stores' =
			
			VAR netM = [Network Margin %]
			RETURN
			COUNTROWS(FILTER(VALUES(dim_store[store_id]), [Net Margin %] < netM))
		formatString: 0
		lineageTag: 21d2a28f-b406-49be-a1ac-82bab8ce1e33

	measure 'Ref Margin Recovery' =
			
			VAR n = [Below-Par Stores]
			VAR netM = [Network Margin %]
			RETURN
			IF(n = 0, "All stores are at or above network margin of " & FORMAT(netM, "0.0%"),
			    IF([Net Profit] > 0,
			        "+" & FORMAT(DIVIDE([Margin Recovery Potential], [Net Profit]), "0.0%") &
			            " on net profit if " & n & IF(n = 1, " store", " stores") & " reach " & FORMAT(netM, "0.0%"),
			        n & IF(n = 1, " store", " stores") & " below network margin of " & FORMAT(netM, "0.0%")))
		lineageTag: 13511e6e-e5b0-4ddd-bd64-633fde85c4e4

	measure 'Ref Rev per Staff Hr' =
			
			VAR net = CALCULATE([Revenue per Staff Hour], ALL(dim_store))
			VAR d = [Revenue per Staff Hour] - net
			RETURN FORMAT(ABS(d), "£0.00") & " " & IF(d >= 0, "above", "below") &
			    " network average of " & FORMAT(net, "£0.00")
		lineageTag: 8f3ab9ca-9803-4970-aeb1-8402854c216e

	measure 'Ref Staffing %' =
			
			VAR net = CALCULATE([Staffing % Rev], ALL(dim_store))
			VAR gap = [Staffing % Rev] - net
			RETURN FORMAT(ABS(gap), "0.00%") & IF(gap > 0, " above", " below") &
			    " network (" & FORMAT(net, "0.00%") & ")"
		lineageTag: c4232117-bf24-49bb-b15d-2d301399085e

	measure 'Ref Peak-to-Dead' =
			
			VAR net = CALCULATE([Peak-to-Dead Ratio], ALL(dim_store))
			RETURN "Peak hours carry " & FORMAT([Peak-to-Dead Ratio], "0.00") & "x dead-hour volume (network " &
			    FORMAT(net, "0.00") & "x)"
		lineageTag: f250d0a1-6e47-470a-ac5b-f82499b3b30b

	measure 'Ref Dwell Time' =
			
			VAR net = CALCULATE([Avg Dwell Time], ALL(dim_store))
			VAR d = [Avg Dwell Time] - net
			RETURN FORMAT(ABS(d), "0.00") & " min " & IF(d >= 0, "longer", "shorter") &
			    " than network average of " & FORMAT(net, "0.00") & " min"
		lineageTag: 1349204d-499b-4a6e-8ab8-825c14812f73

	measure 'Ref Txn per Staff Hr' =
			
			VAR net = CALCULATE([Transaction per Staff Hour], ALL(dim_store))
			VAR d = [Transaction per Staff Hour] - net
			RETURN FORMAT(ABS(d), "0.00") & " " & IF(d >= 0, "above", "below") &
			    " network average of " & FORMAT(net, "0.00")
		lineageTag: 3a3927f2-52e6-4abd-8979-331e2d799168

	measure 'Ref Rev per Footfall' =
			
			VAR net = CALCULATE([Revenue per Footfall], ALL(dim_store))
			VAR d = [Revenue per Footfall] - net
			RETURN FORMAT(ABS(d), "£0.00") & " " & IF(d >= 0, "above", "below") &
			    " network (" & FORMAT(net, "£0.00") & ") per visitor"
		lineageTag: a68e6550-972d-4c5c-88a8-2a958da83334

	measure 'Flagged Stores Margin Gap' =
			
			AVERAGEX(
			    FILTER(VALUES(dim_store[store_id]), [Store Risk Score] >= 3),
			    [Margin Gap (pts)]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 885429de-d020-4acd-b35e-0a0891621146

	measure 'Ref Loyalty Revenue' =
			
			VAR bench = IF([Store Filtered], CALCULATE([Loyalty Revenue %], ALL(dim_store)),
			                                 MEDIANX(ALL(dim_store[store_id]), [Loyalty Revenue %]))
			VAR lbl = IF([Store Filtered], "network", "median store")
			RETURN "Members drive " & FORMAT([Loyalty Revenue %], "0.00%") & " of spend (" & lbl & " " & FORMAT(bench, "0.00%") & ")"
		lineageTag: 64c34504-ef92-41b7-a48f-145d548c2771

	measure 'Ref Loyalty Cost' =
			
			VAR bench = IF([Store Filtered], CALCULATE([Loyalty Cost % Rev], ALL(dim_store)),
			                                 MEDIANX(ALL(dim_store[store_id]), [Loyalty Cost % Rev]))
			VAR lbl = IF([Store Filtered], "network", "median store")
			VAR gap = [Loyalty Cost % Rev] - bench
			RETURN FORMAT(ABS(gap), "0.00%") & IF(gap > 0, " above", " below") & " " & lbl & " (" & FORMAT(bench, "0.00%") & ")"
		lineageTag: 71ac9b0d-5329-42cf-9b30-86bee79324bf

	measure 'Ref Rent %' =
			
			VAR bench = IF([Store Filtered], CALCULATE([Rent % Rev], ALL(dim_store)),
			                                 MEDIANX(ALL(dim_store[store_id]), [Rent % Rev]))
			VAR lbl = IF([Store Filtered], "network", "median store")
			VAR gap = [Rent % Rev] - bench
			RETURN FORMAT(ABS(gap), "0.00%") & IF(gap > 0, " above", " below") & " " & lbl & " (" & FORMAT(bench, "0.00%") & ")"
		lineageTag: 7db4e635-8af1-4c2c-b5ae-5c5dab2a217c

	measure 'Ref Gross Margin' =
			
			VAR bench = IF([Store Filtered], CALCULATE([Gross Margin %], ALL(dim_store)),
			                                 MEDIANX(ALL(dim_store[store_id]), [Gross Margin %]))
			VAR lbl = IF([Store Filtered], "network", "median store")
			VAR gap = [Gross Margin %] - bench
			RETURN FORMAT(ABS(gap), "0.00%") & IF(gap >= 0, " above", " below") & " " & lbl & " (" & FORMAT(bench, "0.00%") & ")"
		lineageTag: d9b0e565-225e-4c57-9af3-9f8f887609d7

	measure 'Ref Stores Action' =
			
			VAR pct = DIVIDE([Stores Needing Action], [Active Stores])
			RETURN
			[Stores Needing Action] & " of " & [Active Stores] & " stores (" &  FORMAT(pct,"0.00%") & ") score 3+ on structural risk"
		lineageTag: a77dacd0-2973-4c61-b550-8d34b87c1d5d

	measure 'Ref Flagged Gap' =
			
			VAR g = [Flagged Stores Margin Gap]
			RETURN IF(ISBLANK(g), "No stores currently flagged",
			    "Flagged stores run " & FORMAT(ABS(g), "0.00%") &
			    IF(g < 0, " below", " above") & " network margin")
		lineageTag: 1aaabcd7-1512-4689-9c5e-309f3d53624c

	measure 'Loyalty-Margin r' =
			
			VAR t =
			    ADDCOLUMNS(
			        FILTER(VALUES(dim_store[store_id]), [Revenue] > 0),
			        "xv", [Loyalty Revenue %],
			        "yv", [Net Margin %]
			    )
			VAR n   = COUNTROWS(t)
			VAR sx  = SUMX(t, [xv])
			VAR sy  = SUMX(t, [yv])
			VAR sxy = SUMX(t, [xv] * [yv])
			VAR sxx = SUMX(t, [xv] ^ 2)
			VAR syy = SUMX(t, [yv] ^ 2)
			RETURN DIVIDE(n * sxy - sx * sy, SQRT((n * sxx - sx ^ 2) * (n * syy - sy ^ 2)))
		lineageTag: b0cad0ea-3db2-4da1-af71-3316ad4a1d5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Primary Cost Driver' =
			
			VAR sGap = [Staffing % Rev] - CALCULATE([Staffing % Rev], ALL(dim_store))
			VAR rGap = [Rent % Rev] - CALCULATE([Rent % Rev], ALL(dim_store))
			RETURN IF([Store Risk Score] < 2, "-", IF(sGap >= rGap, "Staffing", "Rent"))
		lineageTag: 026e9aa6-d7d2-4d0a-b776-de7fbcec9e12

	measure 'Loyalty Cost' = SUM(fact_store_monthly_profitability[loyalty_redemption_cost_gbp])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: fbb7c915-ade8-438a-9b6d-263fb25c42fe

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Store Filtered' = ISFILTERED(dim_store)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 19172ec8-92ff-4bfe-bb9e-b80a5f876a51

	measure 'P1 subtitle' = "Where profit leaks: fixed costs take " & FORMAT([Fixed Cost % Rev], "0.00%") & " of every £1"
		lineageTag: 4171d0f5-9baa-4cb8-81cb-02552a868eda

	measure 'P1 Overlay' =
			
			FORMAT([Revenue] / 1000000, "£0.0") & "M revenue converts to a " & FORMAT([Net Margin %], "0.0%") &
			" net margin. Rent and staffing absorb " & FORMAT([Fixed Cost % Rev], "0.0%") &
			" of revenue, and " & FORMAT([Loss Months %], "0.0%") & " of store-months make a loss."
		lineageTag: a1a6ff9f-5953-4c31-b48a-2ace84367cf1

	measure 'Loss Months %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_store_monthly_profitability), fact_store_monthly_profitability[net_profit_gbp] < 0),
			    COUNTROWS(fact_store_monthly_profitability)
			)
		lineageTag: 08c00500-94c8-4e69-b5bc-e7a9b5ec74db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P2 Overlay' =
			
			"Staffing takes " & FORMAT([Staffing % Rev], "0.00%") & " of revenue. Revenue per staff hour is " &
			FORMAT([Revenue per Staff Hour], "£0.00") & " (sample basis), and peak hours carry " &
			FORMAT([Peak-to-Dead Ratio], "0.00") & "x dead-hour volume."
		lineageTag: 75f00826-49e7-4177-a9d4-de3fbd3e6145

	partition 'Measure Table' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_ResultType = Table

