		annotation SummarizationSetBy = Automatic

	column 'Margin Band' =
			
			VAR m = DIVIDE([net_profit_gbp], [total_monthly_revenue_gbp])
			RETURN SWITCH(TRUE(), m < 0, "1 Loss-making", m < 0.05, "2 Thin (0-5%)",
			              m < 0.12, "3 Healthy (5-12%)", "4 Strong (12%+)")
		lineageTag: a2f9f16c-9e6e-4019-abff-3426205f1a74
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Fixed Cost % Row' =
			
			DIVIDE([monthly_rent_gbp] + [monthly_staffing_cost_gbp], [total_monthly_revenue_gbp])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 98f721dd-6954-4146-9cf8-d525ca211a93
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

