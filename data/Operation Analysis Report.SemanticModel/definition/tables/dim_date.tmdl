				  #"Extracted first characters" = Table.TransformColumns(#"Changed column type", {{"month_name", each Text.Start(_, 1), type text}, {"day_of_week", each Text.Start(_, 1), type text}}),
				  #"Inserted day of week" = Table.AddColumn(#"Extracted first characters", "Day of week", each Date.DayOfWeek([full_date]), type nullable number),
				  #"Renamed columns" = Table.RenameColumns(#"Inserted day of week", {{"Day of week", "Day of week number"}}),
				  #"Inserted start of year" = Table.AddColumn(#"Renamed columns", "Start of year", each Date.StartOfYear([full_date]), type nullable date),
