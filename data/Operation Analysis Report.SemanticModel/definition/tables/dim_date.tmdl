				  #"Inserted start of quarter" = Table.AddColumn(#"Inserted start of month", "Start of quarter", each Date.StartOfQuarter([full_date]), type nullable date),
				  #"Inserted start of week" = Table.AddColumn(#"Inserted start of quarter", "Start of week", each Date.StartOfWeek([full_date]), type nullable date),
				  #"Inserted start of day" = Table.AddColumn(#"Inserted start of week", "Start of day", each Date.StartOfDay([full_date]), type nullable date),
				  #"Added prefix" = Table.TransformColumns(#"Inserted start of day", {{"quarter", each "Qtr" & Text.From(_), type text}}),
				  #"Inserted quarter" = Table.AddColumn(#"Added prefix", "Quarter (2)", each Date.QuarterOfYear([full_date]), type nullable number),
				  #"Renamed columns 1" = Table.RenameColumns(#"Inserted quarter", {{"Quarter (2)", "Quarter No"}}),
				  #"Inserted day name" = Table.AddColumn(#"Renamed columns 1", "Day name", each Date.DayOfWeekName([full_date]), type nullable text),
